---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CookieBar from '~/components/CookieBar.astro';
import GA4 from '~/components/GA4.astro';
import StickyCallBar from '~/components/StickyCallBar.astro';
import { site } from '~/lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/og-image.jpg' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — Serwis naprawy okien`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(image, site.url).toString();

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.legal.name,
  alternateName: site.name,
  image: ogImageUrl,
  url: site.url,
  telephone: site.contact.phone,
  priceRange: '$$',
  address: (() => {
    const [street, cityPart] = site.legal.address.split(',').map((s) => s.trim());
    const [postalCode, ...cityWords] = (cityPart ?? '').split(' ');
    return {
      '@type': 'PostalAddress',
      streetAddress: street,
      postalCode,
      addressLocality: cityWords.join(' '),
      addressCountry: 'PL',
    };
  })(),
  areaServed: site.serviceArea.map((name) => ({ '@type': 'City', name })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '312',
  },
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#14140f" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />

    <!-- Theme bootstrap: BEFORE paint to avoid FOUC. Light is default; dark is opt-in via toggle. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (_) {}
      })();
    </script>

    <GA4 />
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <StickyCallBar />
    <CookieBar />
  </body>
</html>
