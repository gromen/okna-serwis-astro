---
import { site } from '~/lib/site';

const gtmId = site.gtmId;
const googleAdsId = site.googleAdsId;
const phoneClickLabel = site.googleAdsPhoneClickLabel;
const enabled = import.meta.env.PROD && !!gtmId;
---

{enabled && (
  <>
    <script is:inline>
      (function () {
        // Block on localhost/127.* — avoids polluting analytics during `astro preview`.
        const host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host.endsWith('.local')) {
          window.__GTM_DISABLED__ = true;
          return;
        }
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;

        // Read any previously stored consent choice now, synchronously — the GA4 tag in GTM
        // fires on gtm.init, which evaluates before CookieBar's script runs (it lives near
        // the end of <body>). Waiting for CookieBar to push a consent update arrives too late
        // for returning visitors who already accepted, so the tag never fires again.
        const storedConsent = (() => { try { return localStorage.getItem('cookie-consent'); } catch { return null; } })();
        const granted = storedConsent === 'accept';

        gtag('consent', 'default', {
          ad_storage: granted ? 'granted' : 'denied',
          ad_user_data: granted ? 'granted' : 'denied',
          ad_personalization: granted ? 'granted' : 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          wait_for_update: 500,
        });
      })();
    </script>
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        if (w.__GTM_DISABLED__) return;
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
    {googleAdsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`}></script>
        <script is:inline define:vars={{ googleAdsId }}>
          if (!window.__GTM_DISABLED__) {
            gtag('js', new Date());
            gtag('config', googleAdsId);
          }
        </script>
        {phoneClickLabel && (
          <script is:inline define:vars={{ googleAdsId, phoneClickLabel }}>
            if (!window.__GTM_DISABLED__) {
              document.addEventListener('click', function (e) {
                const link = e.target.closest('a[href^="tel:"]');
                if (!link) return;
                gtag('event', 'conversion', { send_to: googleAdsId + '/' + phoneClickLabel });
              });
            }
          </script>
        )}
      </>
    )}
  </>
)}
