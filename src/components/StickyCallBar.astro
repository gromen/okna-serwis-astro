---
import { site } from '~/lib/site';
---
<div id="sticky-call-bar" style="position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;align-items:center;justify-content:center;gap:10px;background:#14140f;padding:12px;">
  <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} style="display:flex;align-items:center;gap:10px;color:#f7f5f0;font-size:13px;font-weight:500;">
    <span style="width:8px;height:8px;background:#c8643a;border-radius:50%;flex-shrink:0;"></span>
    {site.contact.phone}
  </a>
</div>

<style>
  @media (min-width: 768px) {
    #sticky-call-bar {
      display: none !important;
    }
  }
</style>
