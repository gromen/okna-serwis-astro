---
import { site } from '~/lib/site';

interface Props { query?: string; title?: string; height?: number; }
const {
  query = site.map.query,
  title = `Mapa: ${site.map.label}`,
  height = 380,
} = Astro.props;

// No API key required. TODO: swap the generic "Warszawa" query for a real address
// once the business confirms a fixed office/depot location.
const src = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&t=&z=10&ie=UTF8&iwloc=&output=embed`;
---
<div style="border:1px solid var(--color-border-strong); overflow:hidden;">
  <iframe src={src} title={title} width="100%" height={height} loading="lazy"
          referrerpolicy="no-referrer-when-downgrade" style="border:0; display:block;"></iframe>
</div>
