---
import { Image } from 'astro:assets';
import { site } from '~/lib/site';
import ThemeToggle from '~/components/ThemeToggle.astro';
import logo from '~/assets/logo-perfokno-removebg-preview.png';
---

<header style="position:sticky;top:0;z-index:40;background:var(--color-bg);border-bottom:1px solid var(--color-border);">
  <div class="container-page" style="display:flex;align-items:center;justify-content:space-between;padding-block:16px;">
    <a href="/" aria-label={site.name} class="logo-chip">
      <Image src={logo} alt={site.name} width={140} height={82} style="display:block;height:40px;width:auto;" />
    </a>

    <nav id="site-nav" style="display:none;gap:24px;align-items:center;">
      {site.nav.map((item) => (
        <a href={item.href} style="font-size:14px;font-weight:500;">{item.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:10px;">
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="btn btn-primary" style="display:none;">
        Zadzwoń · {site.contact.phone}
      </a>
      <ThemeToggle />
      <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Otwórz menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav">
    <div class="mobile-nav-inner">
      {site.nav.map((item, i) => (
        <a href={item.href} class="mobile-nav-link" style={`--i:${i}`}>{item.label}</a>
      ))}
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="btn btn-primary mobile-nav-link" style={`--i:${site.nav.length};margin-top:14px;`}>
        Zadzwoń · {site.contact.phone}
      </a>
    </div>
  </nav>
</header>

<style>
  .logo-chip {
    display: flex;
    align-items: center;
    background: transparent;
    border-radius: 8px;
    padding: 4px 0;
  }

  :global(:root[data-theme="dark"]) .logo-chip {
    background: #fff;
    padding: 4px 10px;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle-bar {
    width: 16px;
    height: 2px;
    background: var(--color-ink);
    display: block;
    transform-origin: center;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    display: grid;
    grid-template-rows: 0fr;
    border-top: 1px solid transparent;
    transition: grid-template-rows 0.3s ease, border-color 0.3s ease;
  }

  .mobile-nav.is-open {
    grid-template-rows: 1fr;
    border-top-color: var(--color-border);
  }

  .mobile-nav-inner {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0 20px;
  }

  .mobile-nav.is-open .mobile-nav-inner {
    padding: 8px 20px 16px;
  }

  .mobile-nav-link {
    padding: 12px 0;
    font-size: 15px;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(-6px);
  }

  .mobile-nav.is-open .mobile-nav-link {
    animation: mobile-nav-link-in 0.3s ease forwards;
    animation-delay: calc(var(--i, 0) * 40ms);
  }

  a.btn.mobile-nav-link {
    border-bottom: none;
  }

  @keyframes mobile-nav-link-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle-bar,
    .mobile-nav,
    .mobile-nav-link {
      transition: none;
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 768px) {
    #site-nav {
      display: flex !important;
    }
    a.btn.btn-primary {
      display: inline-flex !important;
    }
    .nav-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const toggle = document.getElementById('nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    if (!toggle || !mobileNav) return;
    toggle.addEventListener('click', () => {
      const open = mobileNav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
